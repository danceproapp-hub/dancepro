# Public by design — these are compiled into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile. The site key is public; the secret never is.
# Leave the secret empty and the signup route skips verification, which
# means no bot protection at all — it is not a safe production state.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only. Set this in Vercel (never in the repo) and then apply
# migration 0010, which revokes public access to join_waitlist.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail mailbox used to ask a parent to confirm an under-16 signup.
# Generate an app password at Google Account > Security > App passwords.
# Without both, under-16 signups are refused rather than left pending.
GMAIL_USER=
GMAIL_APP_PASSWORD=
